---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.jsx';

const {
  title,
  description = 'nishTees — 240 GSM oversized streetwear, made in India.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/anton-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body class="bg-paper text-ink antialiased">
    <slot />
    <ChatWidget client:idle />
  </body>
</html>
