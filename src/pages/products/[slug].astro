---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductImage from '../../components/ProductImage.astro';
import AddToBag from '../../components/AddToBag.jsx';
import { getProducts } from '../../lib/catalogue.js';
import { formatPaise } from '../../lib/format.js';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const careInstructions = [
  'Machine wash cold, inside out',
  'No bleach',
  'Tumble dry low or line dry in shade',
  'Iron inside out, low heat',
];
---

<Layout title={`${product.name} — nishTees`} description={product.description ?? undefined}>
  <Header />

  <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <ProductImage alt={product.name} tone="light" loading="eager" />
        <div class="mt-3 grid grid-cols-4 gap-3">
          {[0, 1, 2, 3].map(() => <ProductImage alt="" tone="light" />)}
        </div>
      </div>

      <div class="lg:sticky lg:top-10 lg:self-start">
        <h1 class="font-display text-4xl tracking-tight sm:text-5xl">{product.name}</h1>
        <p class="mt-3 text-2xl font-medium tabular-nums">
          {formatPaise(product.price_paise)}
          <span class="ml-2 text-sm font-normal text-ink/50">Incl. of all taxes</span>
        </p>

        <div class="mt-8">
          <AddToBag client:load variants={product.variants} />
        </div>

        {
          product.description && (
            <p class="mt-8 text-ink/80">{product.description}</p>
          )
        }

        <div class="mt-8 border-t border-ink/10 pt-6">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-ink/60">
            Care Instructions
          </h2>
          <ul class="mt-3 space-y-1 text-sm text-ink/80">
            {careInstructions.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink/60">
          <a href="/size-guide" class="underline underline-offset-2 hover:text-accent">
            Size guide
          </a>
          <span aria-hidden="true">&middot;</span>
          <span>Country of origin: India</span>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
