---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Size Guide — nishTees"
  description="Size guide for nishTees oversized tees — coming soon."
>
  <Header />

  <main class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
    <h1 class="font-display text-4xl tracking-tight sm:text-5xl">Size Guide</h1>
    <p class="mt-4 text-ink/70">
      We're measuring the garments properly before publishing numbers here,
      rather than guess and risk sending you the wrong fit. Check back soon.
    </p>
    <p class="mt-4 text-ink/70">
      Need a size right now? Email
      <a href="mailto:support@nishtees.in" class="underline underline-offset-2 hover:text-accent">
        support@nishtees.in
      </a>
      and we'll help you pick one.
    </p>
  </main>

  <Footer />
</Layout>
