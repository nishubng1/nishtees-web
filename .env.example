# Copy to .dev.vars for local development (wrangler reads that file).
# In production set these in Cloudflare Pages -> Settings -> Environment variables,
# marked as "Encrypt" for every secret below.
#
# .dev.vars and .env must be in .gitignore. Never commit a real secret.

# --- Supabase (Worker runtime, functions/api/*) ----------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: full database access, bypasses RLS.
# Server-side only. If this leaks, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (astro build, catalogue pages) -------------------
# Copy these two into a separate .env file (not .dev.vars) so `astro build`
# can read them via import.meta.env. The anon key is safe to use here: it
# only reaches the build process on your machine/CI, never the browser
# bundle, and is scoped by the read-only RLS policies in schema.sql.
SUPABASE_ANON_KEY=

# --- Razorpay -------------------------------------------------
# Key ID is public (it is sent to the browser). Secret is not.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Any long random string you also paste into the Razorpay webhook config.
RAZORPAY_WEBHOOK_SECRET=

# --- Email (optional at launch) -------------------------------
RESEND_API_KEY=
